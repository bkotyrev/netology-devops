# Local Terraform directories and files
.terraform/
.terraform*

!.terraformrc

# Terraform state files can contain generated passwords.
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Local credentials and personal values.
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
!*.tfvars.example
!*.tfvars.json.example
personal.auto.tfvars

# Local plans, crash logs, keys, and environment files.
*.tfplan
*.tfout
plan.out
crash.log
crash.*.log
.authorized_key.json
authorized_key.json
*.pem
*.key
.env
.env.*
